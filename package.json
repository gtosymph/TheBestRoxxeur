{
  "name": "copyroxx",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "description": "Moteur de calcul et solveur genetique de stuff Dofus",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data:effects": "node scripts/fetch-effects.mjs",
    "data:items": "node scripts/fetch-items.mjs",
    "data:sets": "node scripts/fetch-sets.mjs",
    "data:avatars": "node scripts/fetch-avatars.mjs",
    "data:icons": "node scripts/fetch-item-icons.mjs",
    "data:monsters": "node scripts/fetch-monsters.mjs",
    "data:sorts": "node scripts/import-spells.mjs",
    "data:diff": "node scripts/diff-catalogue.mjs",
    "audit:sorts": "node scripts/audit-spells.mjs",
    "data:all": "npm run data:effects && npm run data:sets && npm run data:items && npm run data:monsters && npm run data:sorts",
    "test": "node --test test/*.test.mjs",
    "bench": "node scripts/bench-convergence.mjs",
    "bench:gate": "node scripts/bench-convergence.mjs --gate",
    "smoke": "node scripts/smoke-navigateur.mjs",
    "serve": "node scripts/serve.mjs",
    "solve": "node scripts/solve-parallel-demo.mjs"
  }
}
